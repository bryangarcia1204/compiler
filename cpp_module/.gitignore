*.la
*.d
*.exe
*.dll # Si libwinpthread-1.dll es generada o copiada al directorio de salida
*.lib
*.exp

# Archivos de IDEs
.vscode/
.idea/
*.swp
*~

# Archivos de sistema operativo
.DS_Store
Thumbs.db