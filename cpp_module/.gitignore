# Ignorar directorios de compilación y archivos generados
build/
dist/
*.egg-info/
__pycache__/
.pytest_cache/

# Archivos específicos de Python
*.pyc
*.pyd  # Módulo compilado de Python (Windows)
*.so   # Módulo compilado de Python (Linux/macOS)

